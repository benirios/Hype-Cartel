@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin · Dashboard";

    var totalStatusOrders = Model.OrdersByStatus.Sum(x => x.Count);
    var categories = Model.Categories;
    var monthlyLabels = Model.MonthlyRevenue.Select(x => $"{x.Month:00}/{x.Year.ToString()[2..]}").ToList();
    var monthlyRevenueValues = Model.MonthlyRevenue.Select(x => decimal.Round(x.Revenue, 2, MidpointRounding.AwayFromZero)).ToList();
    var orderStatusLabels = Model.OrdersByStatus.Select(x => x.Status).ToList();
    var orderStatusValues = Model.OrdersByStatus.Select(x => x.Count).ToList();
    var topProductLabels = Model.TopProducts.Select(x => x.ProductName).ToList();
    var topProductValues = Model.TopProducts.Select(x => x.QuantitySold).ToList();

    var monthlyLabelsJson = System.Text.Json.JsonSerializer.Serialize(monthlyLabels);
    var monthlyRevenueValuesJson = System.Text.Json.JsonSerializer.Serialize(monthlyRevenueValues);
    var orderStatusLabelsJson = System.Text.Json.JsonSerializer.Serialize(orderStatusLabels);
    var orderStatusValuesJson = System.Text.Json.JsonSerializer.Serialize(orderStatusValues);
    var topProductLabelsJson = System.Text.Json.JsonSerializer.Serialize(topProductLabels);
    var topProductValuesJson = System.Text.Json.JsonSerializer.Serialize(topProductValues);
}

<section class="admin-dashboard-hero">
    <div class="container">
        <div class="admin-dashboard-hero__content">
            <h1 class="admin-dashboard-hero__title">Dashboard</h1>
            <p class="admin-dashboard-hero__subtitle">Manage your store, products, and orders</p>
        </div>
    </div>
</section>

<section class="container admin-dashboard">
    @if (TempData["AdminError"] is string adminError && !string.IsNullOrWhiteSpace(adminError))
    {
        <div class="auth-form__error" style="margin-bottom:1rem;">@adminError</div>
    }

    @if (TempData["AdminSuccess"] is string adminSuccess && !string.IsNullOrWhiteSpace(adminSuccess))
    {
        <div class="admin-dashboard__success">@adminSuccess</div>
    }

    <nav class="admin-tabs" aria-label="Admin dashboard sections">
        <a class="admin-tabs__link @(Model.ActiveTab == "overview" ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="Dashboard"
           asp-route-tab="overview">Overview</a>

        <a class="admin-tabs__link @(Model.ActiveTab == "products" ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="Dashboard"
           asp-route-tab="products">Products</a>

        <a class="admin-tabs__link @(Model.ActiveTab == "categories" ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="Dashboard"
           asp-route-tab="categories">Categories</a>

        <a class="admin-tabs__link @(Model.ActiveTab == "orders" ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="Dashboard"
           asp-route-tab="orders">Orders</a>

        <a class="admin-tabs__link @(Model.ActiveTab == "users" ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="Dashboard"
           asp-route-tab="users">Users</a>

        <a class="admin-tabs__link @(Model.ActiveTab == "reports" ? "is-active" : string.Empty)"
           asp-controller="Admin"
           asp-action="Dashboard"
           asp-route-tab="reports">Reports</a>
    </nav>

    @if (Model.ActiveTab == "overview")
    {
        <div class="admin-dashboard__kpis-compact admin-dashboard__kpis-compact--refined">
            <article class="admin-kpi-compact admin-kpi-compact--feature">
                <span class="admin-kpi-compact__label">Total Revenue</span>
                <span class="admin-kpi-compact__value">$@Model.TotalRevenue.ToString("0.00")</span>
                <span class="admin-kpi-compact__hint">Primary business metric</span>
            </article>

            <article class="admin-kpi-compact">
                <span class="admin-kpi-compact__label">Total Orders</span>
                <span class="admin-kpi-compact__value">@Model.TotalOrders</span>
            </article>

            <article class="admin-kpi-compact">
                <span class="admin-kpi-compact__label">Avg Order</span>
                <span class="admin-kpi-compact__value">$@Model.AverageOrderValue.ToString("0.00")</span>
            </article>

            <article class="admin-kpi-compact">
                <span class="admin-kpi-compact__label">Pending</span>
                <span class="admin-kpi-compact__value">@Model.PendingOrders</span>
            </article>

            <article class="admin-kpi-compact">
                <span class="admin-kpi-compact__label">Products</span>
                <span class="admin-kpi-compact__value">@Model.TotalProducts</span>
            </article>

            <article class="admin-kpi-compact">
                <span class="admin-kpi-compact__label">Users</span>
                <span class="admin-kpi-compact__value">@Model.TotalUsers</span>
            </article>

            <article class="admin-kpi-compact">
                <span class="admin-kpi-compact__label">Low Stock</span>
                <span class="admin-kpi-compact__value">@Model.LowStockProducts</span>
            </article>
        </div>

        <div class="admin-dashboard__charts">
            <article class="admin-chart-card">
                <h3 class="admin-chart-card__title">Revenue by Month</h3>
                @if (Model.MonthlyRevenue.Count == 0)
                {
                    <p class="admin-chart-card__empty">No data available</p>
                }
                else
                {
                    <div class="admin-chart-canvas-wrap">
                        <canvas id="overviewRevenueChart" aria-label="Revenue by month"></canvas>
                    </div>
                }
            </article>

            <article class="admin-chart-card">
                <h3 class="admin-chart-card__title">Orders by Status</h3>
                @if (Model.OrdersByStatus.Count == 0)
                {
                    <p class="admin-chart-card__empty">No data available</p>
                }
                else
                {
                    <div class="admin-chart-canvas-wrap admin-chart-canvas-wrap--sm">
                        <canvas id="overviewStatusChart" aria-label="Orders by status"></canvas>
                    </div>
                    <div class="admin-chart-stats">
                        @foreach (var item in Model.OrdersByStatus)
                        {
                            var pct = totalStatusOrders > 0
                                ? Math.Round((decimal)item.Count / totalStatusOrders * 100m, 1)
                                : 0m;
                            <div class="admin-chart-stats__item">
                                <span>@item.Status</span>
                                <strong>@item.Count (@pct.ToString("0.#")%)</strong>
                            </div>
                        }
                    </div>
                }
            </article>
        </div>

        <article class="admin-table-card">
            <div class="admin-table-card__header">
                <h3 class="admin-table-card__title">Recent Orders</h3>
                <a class="btn-ghost" asp-controller="Admin" asp-action="Dashboard" asp-route-tab="orders">View All</a>
            </div>
            @if (Model.RecentOrders.Count == 0)
            {
                <p class="admin-chart-card__empty">No orders yet</p>
            }
            else
            {
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>User</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td><strong>#@order.OrderId</strong></td>
                                <td>@order.UserId</td>
                                <td><span class="admin-badge admin-badge--@order.Status.ToString().ToLower()">@order.Status</span></td>
                                <td>$@order.Total.ToString("0.00")</td>
                                <td>@order.CreatedAtUtc.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <a class="btn-ghost-small"
                                       asp-controller="Admin"
                                       asp-action="Dashboard"
                                       asp-route-tab="orders"
                                       asp-route-orderId="@order.OrderId">View</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    }

    @if (Model.ActiveTab == "products")
    {
        <!-- Create New Product Modal Trigger -->
        <div class="admin-section-header">
            <h2 class="admin-section-title">Products Management</h2>
            <button class="btn-primary" onclick="toggleCreateModal()">+ Create Product</button>
        </div>

        <!-- Create Product Modal -->
        <div id="createProductModal" class="admin-modal" style="display:none;">
            <div class="admin-modal__overlay" onclick="toggleCreateModal()"></div>
            <div class="admin-modal__content">
                <div class="admin-modal__header">
                    <h3>Create New Product</h3>
                    <button class="admin-modal__close" onclick="toggleCreateModal()">&times;</button>
                </div>
                <form method="post" asp-controller="Admin" asp-action="Criar" class="admin-modal__form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="activeTab" value="products" />
                    
                    <div class="admin-form-group">
                        <label>Product Name</label>
                        <input class="admin-input" name="nome" placeholder="Enter product name" required />
                    </div>
                    
                    <div class="admin-form-row">
                        <div class="admin-form-group">
                            <label>Price</label>
                            <input class="admin-input" name="preco" type="number" step="0.01" min="0" placeholder="0.00" required />
                        </div>
                        <div class="admin-form-group">
                            <label>Stock</label>
                            <input class="admin-input" name="stock" type="number" step="1" min="0" value="100" placeholder="100" required />
                        </div>
                    </div>

                    <div class="admin-form-group">
                        <label>Category</label>
                        <select class="admin-input" name="categoria" required>
                            <option value="">Select category</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.Name">@category.Name</option>
                            }
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>Image URL</label>
                        <input class="admin-input" name="imagemUrl" placeholder="/catalog/image.jpg" required />
                    </div>

                    <div class="admin-form-group">
                        <label>Description</label>
                        <textarea class="admin-input" name="descricao" rows="4" placeholder="Product description" required></textarea>
                    </div>

                    <div class="admin-form-group">
                        <label>Sizes (comma separated)</label>
                        <input class="admin-input" name="tamanhos" placeholder="S, M, L, XL" />
                    </div>

                    <label class="admin-checkbox">
                        <input type="checkbox" name="destaque" value="true" />
                        <span>Feature this product on homepage</span>
                    </label>

                    <div class="admin-modal__actions">
                        <button class="btn-outline" type="button" onclick="toggleCreateModal()">Cancel</button>
                        <button class="btn-primary" type="submit">Create Product</button>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.Products.Count == 0)
        {
            <p class="admin-empty-state">No products found. Create your first product to get started.</p>
        }
        else
        {
            <div class="admin-product-grid">
                @foreach (var product in Model.Products)
                {
                    <article class="admin-product-item">
                        <div class="admin-product-item__image">
                            <img src="@product.ImagemUrl" alt="@product.Nome" />
                            @if (product.Destaque)
                            {
                                <span class="admin-product-item__badge">Featured</span>
                            }
                            @if (product.Stock <= 5)
                            {
                                <span class="admin-product-item__badge admin-product-item__badge--warning">Low Stock</span>
                            }
                        </div>
                        <div class="admin-product-item__info">
                            <h4 class="admin-product-item__name">@product.Nome</h4>
                            <div class="admin-product-item__meta">
                                <span class="admin-product-item__price">$@product.Preco.ToString("0.00")</span>
                                <span class="admin-product-item__stock">Stock: @product.Stock</span>
                            </div>
                            <p class="admin-product-item__category">@product.Categoria</p>
                        </div>
                        <div class="admin-product-item__actions">
                            <button class="btn-ghost" onclick="toggleEditModal(@product.Id)">Edit</button>
                            <form method="post" asp-controller="Admin" asp-action="Remover" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="activeTab" value="products" />
                                <input type="hidden" name="id" value="@product.Id" />
                                <button class="btn-outline-danger" type="submit" onclick="return confirm('Are you sure you want to delete this product?')">Delete</button>
                            </form>
                        </div>

                        <!-- Edit Modal for this product -->
                        <div id="editProductModal@(product.Id)" class="admin-modal" style="display:none;">
                            <div class="admin-modal__overlay" onclick="toggleEditModal(@product.Id)"></div>
                            <div class="admin-modal__content">
                                <div class="admin-modal__header">
                                    <h3>Edit Product #@product.Id</h3>
                                    <button class="admin-modal__close" onclick="toggleEditModal(@product.Id)">&times;</button>
                                </div>
                                <form method="post" asp-controller="Admin" asp-action="Editar" class="admin-modal__form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="activeTab" value="products" />
                                    <input type="hidden" name="id" value="@product.Id" />
                                    
                                    <div class="admin-form-group">
                                        <label>Product Name</label>
                                        <input class="admin-input" name="nome" value="@product.Nome" required />
                                    </div>
                                    
                                    <div class="admin-form-row">
                                        <div class="admin-form-group">
                                            <label>Price</label>
                                            <input class="admin-input" name="preco" type="number" step="0.01" min="0" value="@product.Preco" required />
                                        </div>
                                        <div class="admin-form-group">
                                            <label>Stock</label>
                                            <input class="admin-input" name="stock" type="number" step="1" min="0" value="@product.Stock" required />
                                        </div>
                                    </div>

                                    <div class="admin-form-group">
                                        <label>Category</label>
                                        <select class="admin-input" name="categoria" required>
                                            @foreach (var category in categories)
                                            {
                                                if (string.Equals(product.Categoria, category.Name, StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <option value="@category.Name" selected>@category.Name</option>
                                                }
                                                else
                                                {
                                                    <option value="@category.Name">@category.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>

                                    <div class="admin-form-group">
                                        <label>Image URL</label>
                                        <input class="admin-input" name="imagemUrl" value="@product.ImagemUrl" required />
                                    </div>

                                    <div class="admin-form-group">
                                        <label>Description</label>
                                        <textarea class="admin-input" name="descricao" rows="4" required>@product.Descricao</textarea>
                                    </div>

                                    <div class="admin-form-group">
                                        <label>Sizes (comma separated)</label>
                                        <input class="admin-input" name="tamanhos" value="@string.Join(",", product.Tamanhos)" />
                                    </div>

                                    <label class="admin-checkbox">
                                        <input type="checkbox" name="destaque" value="true" @(product.Destaque ? "checked" : string.Empty) />
                                        <span>Feature this product on homepage</span>
                                    </label>

                                    <div class="admin-modal__actions">
                                        <button class="btn-outline" type="button" onclick="toggleEditModal(@product.Id)">Cancel</button>
                                        <button class="btn-primary" type="submit">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    }

    @if (Model.ActiveTab == "categories")
    {
        <div class="admin-section-header">
            <h2 class="admin-section-title">Categories Management</h2>
            <button class="btn-primary" onclick="toggleCategoryModal()">+ Create Category</button>
        </div>

        <!-- Create Category Modal -->
        <div id="createCategoryModal" class="admin-modal" style="display:none;">
            <div class="admin-modal__overlay" onclick="toggleCategoryModal()"></div>
            <div class="admin-modal__content admin-modal__content--small">
                <div class="admin-modal__header">
                    <h3>Create New Category</h3>
                    <button class="admin-modal__close" onclick="toggleCategoryModal()">&times;</button>
                </div>
                <form method="post" asp-controller="Admin" asp-action="CriarCategoria" class="admin-modal__form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="activeTab" value="categories" />
                    
                    <div class="admin-form-group">
                        <label>Category Name</label>
                        <input class="admin-input" name="nome" placeholder="Enter category name" required />
                    </div>

                    <div class="admin-modal__actions">
                        <button class="btn-outline" type="button" onclick="toggleCategoryModal()">Cancel</button>
                        <button class="btn-primary" type="submit">Create Category</button>
                    </div>
                </form>
            </div>
        </div>

        @if (categories.Count == 0)
        {
            <p class="admin-empty-state">No categories found. Create your first category to get started.</p>
        }
        else
        {
            <div class="admin-category-grid">
                @foreach (var category in categories)
                {
                    <article class="admin-category-item">
                        <div class="admin-category-item__info">
                            <h4 class="admin-category-item__name">@category.Name</h4>
                            <p class="admin-category-item__count">@category.ProductCount products</p>
                        </div>
                        <div class="admin-category-item__actions">
                            <button class="btn-ghost" onclick="toggleEditCategoryModal(@category.Id)">Edit</button>
                            <form method="post" asp-controller="Admin" asp-action="RemoverCategoria" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="activeTab" value="categories" />
                                <input type="hidden" name="id" value="@category.Id" />
                                <button class="btn-outline-danger" type="submit" onclick="return confirm('Delete this category? Products will remain.')">Delete</button>
                            </form>
                        </div>

                        <!-- Edit Category Modal -->
                        <div id="editCategoryModal@(category.Id)" class="admin-modal" style="display:none;">
                            <div class="admin-modal__overlay" onclick="toggleEditCategoryModal(@category.Id)"></div>
                            <div class="admin-modal__content admin-modal__content--small">
                                <div class="admin-modal__header">
                                    <h3>Edit Category #@category.Id</h3>
                                    <button class="admin-modal__close" onclick="toggleEditCategoryModal(@category.Id)">&times;</button>
                                </div>
                                <form method="post" asp-controller="Admin" asp-action="EditarCategoria" class="admin-modal__form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="activeTab" value="categories" />
                                    <input type="hidden" name="id" value="@category.Id" />
                                    
                                    <div class="admin-form-group">
                                        <label>Category Name</label>
                                        <input class="admin-input" name="nome" value="@category.Name" required />
                                    </div>

                                    <div class="admin-modal__actions">
                                        <button class="btn-outline" type="button" onclick="toggleEditCategoryModal(@category.Id)">Cancel</button>
                                        <button class="btn-primary" type="submit">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    }

    @if (Model.ActiveTab == "orders")
    {
        <div class="admin-section-header">
            <h2 class="admin-section-title">Orders Management</h2>
        </div>

        @if (Model.Orders.Count == 0)
        {
            <p class="admin-empty-state">No orders available.</p>
        }
        else
        {
            <div class="admin-table-card">
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>User</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td><strong>#@order.OrderId</strong></td>
                                <td>@order.UserId</td>
                                <td><span class="admin-badge admin-badge--@order.Status.ToString().ToLower()">@order.Status</span></td>
                                <td>$@order.Total.ToString("0.00")</td>
                                <td>@order.CreatedAtUtc.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>
                                    <div class="admin-table-actions">
                                        <a class="btn-ghost-small"
                                           asp-controller="Admin"
                                           asp-action="Dashboard"
                                           asp-route-tab="orders"
                                           asp-route-orderId="@order.OrderId">Details</a>

                                        <form method="post" asp-controller="Admin" asp-action="UpdateOrderStatus" style="display:flex; gap:0.5rem; align-items:center;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="activeTab" value="orders" />
                                            <input type="hidden" name="orderId" value="@order.OrderId" />
                                            <select class="admin-input-small" name="newStatus">
                                                @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                                                {
                                                    if (order.Status == status)
                                                    {
                                                        <option value="@status" selected>@status</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@status">@status</option>
                                                    }
                                                }
                                            </select>
                                            <button class="btn-ghost-small" type="submit">Update</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (Model.SelectedOrder is not null)
        {
            <article class="admin-detail-card">
                <div class="admin-detail-card__header">
                    <h3>Order Details · #@Model.SelectedOrder.Id</h3>
                    <span class="admin-badge admin-badge--@Model.SelectedOrder.Status.ToString().ToLower()">@Model.SelectedOrder.Status</span>
                </div>

                <div class="admin-detail-card__info">
                    <div class="admin-detail-row">
                        <span class="admin-detail-label">Date:</span>
                        <span>@Model.SelectedOrder.CreatedAtUtc.ToString("MMMM dd, yyyy HH:mm")</span>
                    </div>
                    <div class="admin-detail-row">
                        <span class="admin-detail-label">Subtotal:</span>
                        <span>$@Model.SelectedOrder.Subtotal.ToString("0.00")</span>
                    </div>
                    <div class="admin-detail-row">
                        <span class="admin-detail-label">VAT:</span>
                        <span>$@Model.SelectedOrder.Vat.ToString("0.00")</span>
                    </div>
                    <div class="admin-detail-row">
                        <span class="admin-detail-label">Total:</span>
                        <strong>$@Model.SelectedOrder.Total.ToString("0.00")</strong>
                    </div>
                </div>

                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Size</th>
                                <th>Qty</th>
                                <th>Unit Price</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var line in Model.SelectedOrder.Lines)
                        {
                            <tr>
                                <td>@line.ProductName</td>
                                <td>@(string.IsNullOrWhiteSpace(line.Size) ? "-" : line.Size)</td>
                                <td>@line.Quantity</td>
                                <td>$@line.UnitPrice.ToString("0.00")</td>
                                <td>$@line.Subtotal.ToString("0.00")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </article>
        }

        @if (Model.OrderHistory.Count > 0)
        {
            <article class="admin-table-card">
                <h3 class="admin-table-card__title">Order Status History</h3>
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Changed At</th>
                                <th>Changed By</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.OrderHistory)
                        {
                            <tr>
                                <td><strong>#@item.OrderId</strong></td>
                                <td>@item.FromStatus</td>
                                <td>@item.ToStatus</td>
                                <td>@item.ChangedAtUtc.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@item.ChangedBy</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </article>
        }
    }

    @if (Model.ActiveTab == "users")
    {
        <div class="admin-section-header">
            <h2 class="admin-section-title">User Management</h2>
            <form method="get" asp-controller="Admin" asp-action="Dashboard" style="display:flex; gap:0.5rem; align-items:center;">
                <input type="hidden" name="tab" value="users" />
                <input class="admin-input" name="userSearch" value="@Model.UserSearch" placeholder="Search users..." style="min-width:300px;" />
                <button class="btn-outline" type="submit">Search</button>
            </form>
        </div>

        @if (Model.Users.Count == 0)
        {
            <p class="admin-empty-state">No users found.</p>
        }
        else
        {
            <div class="admin-table-card">
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td><strong>@user.Username</strong></td>
                                <td>@user.Email</td>
                                <td><span class="admin-badge admin-badge--@user.Role.ToLower()">@user.Role</span></td>
                                <td><span class="admin-badge @(user.IsActive ? "admin-badge--active" : "admin-badge--inactive")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                                <td>
                                    <div class="admin-table-actions">
                                        <form method="post" asp-controller="Admin" asp-action="UpdateUserRole" style="display:flex; gap:0.5rem; align-items:center;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="activeTab" value="users" />
                                            <input type="hidden" name="userSearch" value="@Model.UserSearch" />
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <select class="admin-input-small" name="role">
                                                @if (user.Role == "Admin")
                                                {
                                                    <option value="Admin" selected>Admin</option>
                                                    <option value="Customer">Customer</option>
                                                }
                                                else
                                                {
                                                    <option value="Admin">Admin</option>
                                                    <option value="Customer" selected>Customer</option>
                                                }
                                            </select>
                                            <button class="btn-ghost-small" type="submit">Save</button>
                                        </form>

                                        <form method="post" asp-controller="Admin" asp-action="ToggleUserActive">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="activeTab" value="users" />
                                            <input type="hidden" name="userSearch" value="@Model.UserSearch" />
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <input type="hidden" name="activate" value="@(!user.IsActive)" />
                                            <button class="btn-outline-small" type="submit">
                                                @(user.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

    @if (Model.ActiveTab == "reports")
    {
        <div class="admin-section-header">
            <h2 class="admin-section-title">Reports & Analytics</h2>
        </div>

        <div class="admin-dashboard__charts">
            <article class="admin-chart-card">
                <h3 class="admin-chart-card__title">Top Selling Products</h3>
                @if (Model.TopProducts.Count == 0)
                {
                    <p class="admin-chart-card__empty">No sales data available</p>
                }
                else
                {
                    <div class="admin-chart-canvas-wrap">
                        <canvas id="reportsTopProductsChart" aria-label="Top selling products"></canvas>
                    </div>
                    <div class="admin-chart-stats">
                        @foreach (var item in Model.TopProducts)
                        {
                            <div class="admin-chart-stats__item">
                                <span>@item.ProductName</span>
                                <strong>@item.QuantitySold units</strong>
                            </div>
                        }
                    </div>
                }
            </article>

            <article class="admin-chart-card">
                <h3 class="admin-chart-card__title">Revenue Trends</h3>
                @if (Model.MonthlyRevenue.Count == 0)
                {
                    <p class="admin-chart-card__empty">No revenue data available</p>
                }
                else
                {
                    <div class="admin-chart-canvas-wrap">
                        <canvas id="reportsRevenueChart" aria-label="Revenue trends"></canvas>
                    </div>
                }
            </article>
        </div>

        <article class="admin-chart-card">
            <h3 class="admin-chart-card__title">Orders Distribution</h3>
            @if (Model.OrdersByStatus.Count == 0)
            {
                <p class="admin-chart-card__empty">No order data available</p>
            }
            else
            {
                <div class="admin-chart-canvas-wrap admin-chart-canvas-wrap--sm">
                    <canvas id="reportsOrdersDistributionChart" aria-label="Orders distribution"></canvas>
                </div>
                <div class="admin-chart-stats">
                    @foreach (var item in Model.OrdersByStatus)
                    {
                        var pct = totalStatusOrders > 0
                            ? Math.Round((decimal)item.Count / totalStatusOrders * 100m, 1)
                            : 0m;
                        <div class="admin-chart-stats__item">
                            <span>@item.Status</span>
                            <strong>@item.Count orders (@pct.ToString("0.#")%)</strong>
                        </div>
                    }
                </div>
            }
        </article>
    }
</section>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const dashboardChartData = {
        monthlyLabels: @Html.Raw(monthlyLabelsJson),
        monthlyRevenueValues: @Html.Raw(monthlyRevenueValuesJson),
        orderStatusLabels: @Html.Raw(orderStatusLabelsJson),
        orderStatusValues: @Html.Raw(orderStatusValuesJson),
        topProductLabels: @Html.Raw(topProductLabelsJson),
        topProductValues: @Html.Raw(topProductValuesJson)
    };

    const chartPalette = ['#d6dde6', '#9aa4b2', '#7c8a9f', '#5f728d', '#465971', '#35455a', '#273547'];
    const chartGridColor = 'rgba(255,255,255,0.10)';
    const chartLabelColor = 'rgba(237,241,246,0.82)';

    function chartBaseOptions() {
        return {
            maintainAspectRatio: false,
            responsive: true,
            plugins: {
                legend: {
                    labels: {
                        color: chartLabelColor,
                        boxWidth: 12,
                        boxHeight: 12,
                        padding: 14
                    }
                },
                tooltip: {
                    backgroundColor: 'rgba(8,8,8,0.95)',
                    borderColor: 'rgba(214,221,230,0.2)',
                    borderWidth: 1,
                    titleColor: '#edf1f6',
                    bodyColor: '#edf1f6'
                }
            },
            scales: {
                x: {
                    ticks: { color: chartLabelColor },
                    grid: { color: chartGridColor }
                },
                y: {
                    ticks: { color: chartLabelColor },
                    grid: { color: chartGridColor }
                }
            }
        };
    }

    function initDashboardCharts() {
        if (typeof Chart === 'undefined') {
            return;
        }

        const overviewRevenueCanvas = document.getElementById('overviewRevenueChart');
        if (overviewRevenueCanvas && dashboardChartData.monthlyLabels.length > 0) {
            new Chart(overviewRevenueCanvas, {
                type: 'line',
                data: {
                    labels: dashboardChartData.monthlyLabels,
                    datasets: [{
                        label: 'Revenue',
                        data: dashboardChartData.monthlyRevenueValues,
                        borderColor: '#d6dde6',
                        backgroundColor: 'rgba(214,221,230,0.16)',
                        tension: 0.35,
                        fill: true,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        borderWidth: 2
                    }]
                },
                options: {
                    ...chartBaseOptions(),
                    plugins: {
                        ...chartBaseOptions().plugins,
                        legend: { display: false }
                    }
                }
            });
        }

        const overviewStatusCanvas = document.getElementById('overviewStatusChart');
        if (overviewStatusCanvas && dashboardChartData.orderStatusLabels.length > 0) {
            new Chart(overviewStatusCanvas, {
                type: 'doughnut',
                data: {
                    labels: dashboardChartData.orderStatusLabels,
                    datasets: [{
                        data: dashboardChartData.orderStatusValues,
                        backgroundColor: chartPalette.slice(0, dashboardChartData.orderStatusLabels.length),
                        borderColor: 'rgba(8,8,8,0.8)',
                        borderWidth: 2
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    responsive: true,
                    cutout: '62%',
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        }

        const reportsTopProductsCanvas = document.getElementById('reportsTopProductsChart');
        if (reportsTopProductsCanvas && dashboardChartData.topProductLabels.length > 0) {
            new Chart(reportsTopProductsCanvas, {
                type: 'bar',
                data: {
                    labels: dashboardChartData.topProductLabels,
                    datasets: [{
                        label: 'Units Sold',
                        data: dashboardChartData.topProductValues,
                        backgroundColor: 'rgba(156,39,176,0.65)',
                        borderColor: 'rgba(186,104,200,0.9)',
                        borderWidth: 1.5,
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    ...chartBaseOptions(),
                    indexAxis: 'y',
                    plugins: {
                        ...chartBaseOptions().plugins,
                        legend: { display: false }
                    }
                }
            });
        }

        const reportsRevenueCanvas = document.getElementById('reportsRevenueChart');
        if (reportsRevenueCanvas && dashboardChartData.monthlyLabels.length > 0) {
            new Chart(reportsRevenueCanvas, {
                type: 'line',
                data: {
                    labels: dashboardChartData.monthlyLabels,
                    datasets: [{
                        label: 'Revenue',
                        data: dashboardChartData.monthlyRevenueValues,
                        borderColor: '#d6dde6',
                        backgroundColor: 'rgba(214,221,230,0.12)',
                        tension: 0.35,
                        fill: true,
                        pointRadius: 2.5,
                        pointHoverRadius: 5,
                        borderWidth: 2
                    }]
                },
                options: {
                    ...chartBaseOptions(),
                    plugins: {
                        ...chartBaseOptions().plugins,
                        legend: { display: false }
                    }
                }
            });
        }

        const reportsOrdersDistributionCanvas = document.getElementById('reportsOrdersDistributionChart');
        if (reportsOrdersDistributionCanvas && dashboardChartData.orderStatusLabels.length > 0) {
            new Chart(reportsOrdersDistributionCanvas, {
                type: 'doughnut',
                data: {
                    labels: dashboardChartData.orderStatusLabels,
                    datasets: [{
                        data: dashboardChartData.orderStatusValues,
                        backgroundColor: chartPalette.slice(0, dashboardChartData.orderStatusLabels.length),
                        borderColor: 'rgba(8,8,8,0.8)',
                        borderWidth: 2
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    responsive: true,
                    cutout: '58%',
                    plugins: {
                        legend: {
                            labels: {
                                color: chartLabelColor,
                                boxWidth: 12,
                                boxHeight: 12
                            }
                        }
                    }
                }
            });
        }
    }

    function toggleCreateModal() {
        const modal = document.getElementById('createProductModal');
        modal.style.display = modal.style.display === 'none' ? 'flex' : 'none';
    }

    function toggleEditModal(productId) {
        const modal = document.getElementById('editProductModal' + productId);
        modal.style.display = modal.style.display === 'none' ? 'flex' : 'none';
    }

    function toggleCategoryModal() {
        const modal = document.getElementById('createCategoryModal');
        modal.style.display = modal.style.display === 'none' ? 'flex' : 'none';
    }

    function toggleEditCategoryModal(categoryId) {
        const modal = document.getElementById('editCategoryModal' + categoryId);
        modal.style.display = modal.style.display === 'none' ? 'flex' : 'none';
    }

    initDashboardCharts();
</script>
}
