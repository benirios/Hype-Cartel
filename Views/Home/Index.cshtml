@{
    ViewData["Title"] = "Store";
}

<section class="hero">
    <video id="heroVideo" class="hero-video" muted playsinline preload="auto">
        <source src="@Url.Content("~/Assets/background.mp4")" type="video/mp4" />
    </video>

    <div class="hero-overlay"></div>
    <div class="hero-fade"></div>

    <div class="hero-content">
        <p class="eyebrow">GANGSTER CLOTHING BRAND FOR GENTLEMANS</p>
        <a class="shop-btn" href="#products">SHOP NOW</a>
    </div>
</section>

<section class="products" id="products">
    <div class="products-header">
        <p class="section-kicker">COLLECTION</p>
        <h2>Featured Pieces</h2>
    </div>

    <div class="product-grid">
        <article class="product-card">
            <div class="product-thumb"></div>
            <h3>Don Vito Coat</h3>
            <p>$189</p>
        </article>
        <article class="product-card">
            <div class="product-thumb"></div>
            <h3>Silk Noir Shirt</h3>
            <p>$109</p>
        </article>
        <article class="product-card">
            <div class="product-thumb"></div>
            <h3>Family Ring</h3>
            <p>$79</p>
        </article>
        <article class="product-card">
            <div class="product-thumb"></div>
            <h3>Empire Trousers</h3>
            <p>$129</p>
        </article>
    </div>
</section>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
