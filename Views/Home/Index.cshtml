@model IEnumerable<MafiaStore.Models.ViewModels.ProdutoViewModel>
@{
    ViewData["Title"] = "Home";
}
<!-- ═══ HERO SECTION ═══ -->
<section class="hero" style="margin-top: calc(var(--navbar-height) * -1);">
    <video id="heroVideo" class="hero__video" playsinline preload="auto">
        <source src="/Assets/background.mp4" type="video/mp4" />
    </video>
    <div class="hero__overlay"></div>
    <div class="hero__fade"></div>

    <div class="hero__content">
        <h1 class="hero__heading animate animate--delay-1 is-visible">Gangster Clothing Brand for Gentlemen</h1>
        <p class="hero__subtitle animate animate--delay-2 is-visible">Luxury Streetwear. Worn in Silence.</p>
        <div class="hero__actions animate animate--delay-3 is-visible">
            <a class="hero__btn" asp-controller="Produtos" asp-action="Index">Shop Now</a>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}

<!-- ═══ FEATURED PIECES ═══ -->
<section class="featured" id="featured">
    <div class="container">
        <div class="featured__header animate">
            <span class="section-label">Collection</span>
            <h2 class="section-title">Featured Pieces</h2>
        </div>

        <div class="product-grid">
            @foreach (var piece in Model)
            {
                <div class="product-card animate">
                    <div class="product-card__image-wrap">
                        <a asp-controller="Produtos"
                           asp-action="Detalhes"
                           asp-route-id="@piece.Id"
                           aria-label="View @piece.Nome details">
                            <img src="@piece.ImagemUrl" asp-append-version="true" alt="@piece.Nome" loading="lazy" />
                        </a>
                        <form class="product-card__overlay" method="post" action="/Carrinho/Adicionar">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="produtoId" value="@piece.Id" />
                            <input type="hidden" name="tamanho" value="@(piece.Tamanhos.FirstOrDefault() ?? "Unico")" />
                            <button class="btn-outline" type="submit">Add to Cart</button>
                        </form>
                    </div>
                    <a class="product-card__info"
                       asp-controller="Produtos"
                       asp-action="Detalhes"
                       asp-route-id="@piece.Id">
                        <div class="product-card__name">@piece.Nome</div>
                        <div class="product-card__price">@piece.Preco.ToString("C")</div>
                    </a>
                </div>
            }
        </div>

        <div class="featured__footer animate">
            <a class="btn-outline" asp-controller="Produtos" asp-action="Index">View All Pieces</a>
        </div>
    </div>
</section>


<!-- ═══ CATEGORIES ═══ -->
<section class="categories">
    <div class="container">
        <div class="categories__header animate">
            <span class="section-label">Browse</span>
            <h2 class="section-title">Shop by Category</h2>
        </div>

        <div class="categories__grid">
            <a class="category-tile category-tile--outerwear animate"
               style="background: linear-gradient(140deg, #0d0d0d 0%, #1b1b1b 45%, #131416 100%);"
               asp-controller="Produtos"
               asp-action="Index"
               asp-route-categoria="Outerwear">
                <div class="category-tile__overlay">
                    <span class="category-tile__name">Outerwear</span>
                </div>
            </a>
            <a class="category-tile category-tile--shirts animate"
               style="background: linear-gradient(150deg, #0b0b0b 0%, #1a1a1a 50%, #141518 100%);"
               asp-controller="Produtos"
               asp-action="Index"
               asp-route-categoria="Shirts">
                <div class="category-tile__overlay">
                    <span class="category-tile__name">Shirts</span>
                </div>
            </a>
            <a class="category-tile category-tile--accessories animate"
               style="background: linear-gradient(145deg, #090909 0%, #1a1a1a 45%, #14161a 100%);"
               asp-controller="Produtos"
               asp-action="Index"
               asp-route-categoria="Accessories">
                <div class="category-tile__overlay">
                    <span class="category-tile__name">Accessories</span>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- ═══ NEWSLETTER ═══ -->
<section class="newsletter">
    <div class="container">
        <div class="newsletter__inner animate">
            <span class="section-label">Exclusive</span>
            <h2 class="newsletter__title">Join the Family</h2>
            <p class="newsletter__text">First access to new drops, private events, and the stories behind the stitches. No noise — only what matters.</p>
            <form class="newsletter__form" action="#" method="post">
                <input class="newsletter__input" type="email" placeholder="Your email address" aria-label="Email address" />
                <button class="newsletter__submit" type="submit">Subscribe</button>
            </form>
        </div>
    </div>
</section>
