<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="HYPE CARTEL — Luxury streetwear for the modern gentleman." />
    <title>@ViewData["Title"] — HYPE CARTEL</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- ═══ NAVBAR ═══ -->
    <nav class="navbar" role="navigation" aria-label="Main navigation">
        <div class="navbar__left">
            <!-- Search icon -->
            <a class="navbar__icon" href="#" aria-label="Search">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
                </svg>
            </a>
            <!-- Desktop nav links -->
            <div class="navbar__nav">
                <a class="navbar__link" asp-controller="Produtos" asp-action="Index">Store</a>
                <a class="navbar__link" asp-controller="Produtos" asp-action="Index">Collections</a>
                <a class="navbar__link" asp-controller="Home" asp-action="Index">About</a>
            </div>
        </div>

        <!-- Centered logo -->
        <a class="navbar__logo" asp-controller="Home" asp-action="Index">HYPE CARTEL</a>

        <div class="navbar__right">
            <!-- Account icon -->
            <a class="navbar__icon" href="#" aria-label="Account">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="8" r="3.5"></circle>
                    <path d="M5.5 21c0-4 2.5-6.5 6.5-6.5s6.5 2.5 6.5 6.5"></path>
                </svg>
            </a>
            <!-- Cart icon with badge -->
            <a class="navbar__icon" asp-controller="Carrinho" asp-action="Index" aria-label="Cart">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 6h15l-1.5 9h-12z"></path>
                    <circle cx="9" cy="20" r="1"></circle>
                    <circle cx="18" cy="20" r="1"></circle>
                    <path d="M1 1h4l1 5"></path>
                </svg>
                <span class="cart-badge">2</span>
            </a>
            <!-- Hamburger (mobile only) -->
            <button class="navbar__hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </nav>

    <!-- ═══ MOBILE MENU ═══ -->
    <div class="mobile-menu" id="mobileMenu" role="navigation" aria-label="Mobile navigation">
        <a class="mobile-menu__link" asp-controller="Produtos" asp-action="Index">Store</a>
        <a class="mobile-menu__link" asp-controller="Produtos" asp-action="Index">Collections</a>
        <a class="mobile-menu__link" asp-controller="Home" asp-action="Index">About</a>
        <a class="mobile-menu__link" asp-controller="Carrinho" asp-action="Index">Cart</a>
    </div>

    <!-- ═══ MAIN CONTENT ═══ -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ═══ FOOTER ═══ -->
    <footer class="footer">
        <div class="container">
            <div class="footer__grid">
                <!-- Brand column -->
                <div>
                    <div class="footer__brand-name">HYPE CARTEL</div>
                    <p class="footer__tagline">Born from shadows and stitched with intent. We dress those who move in silence and speak through presence.</p>
                </div>

                <!-- Quick Links column -->
                <div>
                    <div class="footer__heading">Quick Links</div>
                    <div class="footer__links">
                        <a class="footer__link" asp-controller="Produtos" asp-action="Index">Store</a>
                        <a class="footer__link" asp-controller="Produtos" asp-action="Index">Collections</a>
                        <a class="footer__link" asp-controller="Home" asp-action="Index">About</a>
                        <a class="footer__link" href="#">Contact</a>
                    </div>
                </div>

                <!-- Follow Us column -->
                <div>
                    <div class="footer__heading">Follow Us</div>
                    <div class="footer__socials">
                        <!-- Instagram -->
                        <a class="footer__social" href="#" aria-label="Instagram">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                            </svg>
                        </a>
                        <!-- X / Twitter -->
                        <a class="footer__social" href="#" aria-label="X">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                            </svg>
                        </a>
                        <!-- TikTok -->
                        <a class="footer__social" href="#" aria-label="TikTok">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Bottom bar -->
            <div class="footer__bottom">
                <span class="footer__copy">&copy; 2026 Hype Cartel. All rights reserved.</span>
                <span class="footer__craft">Crafted with obsession.</span>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- ═══ GLOBAL JS — Mobile menu + scroll animations ═══ -->
    <script>
        (function () {
            /* ── Mobile hamburger toggle ── */
            const hamburger = document.getElementById('hamburger');
            const mobileMenu = document.getElementById('mobileMenu');

            if (hamburger && mobileMenu) {
                hamburger.addEventListener('click', function () {
                    const isActive = hamburger.classList.toggle('is-active');
                    mobileMenu.classList.toggle('is-open');
                    hamburger.setAttribute('aria-expanded', isActive);
                });
            }

            /* ── Scroll fade-in animation ── */
            const animElements = document.querySelectorAll('.animate');

            if (animElements.length > 0 && 'IntersectionObserver' in window) {
                const observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

                animElements.forEach(function (el) {
                    observer.observe(el);
                });
            }
        })();
    </script>
</body>
</html>
