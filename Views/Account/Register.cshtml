@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<section class="detail">
    <div class="container container--narrow">
        <div class="auth-card">
            <h1 class="auth-card__title">Create Account</h1>
            <p class="auth-card__subtitle">Join HYPE CARTEL and keep your essentials close.</p>

            <form method="post" asp-controller="Account" asp-action="Register" class="auth-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="auth-form__error"></div>

                <label class="auth-form__label" asp-for="Username">Username</label>
                <input class="auth-form__input" asp-for="Username" autocomplete="username" />
                <span class="auth-form__error" asp-validation-for="Username"></span>

                <label class="auth-form__label" asp-for="Email">Email</label>
                <input class="auth-form__input" asp-for="Email" autocomplete="email" />
                <span class="auth-form__error" asp-validation-for="Email"></span>

                <label class="auth-form__label" asp-for="Password">Password</label>
                <input class="auth-form__input" asp-for="Password" autocomplete="new-password" />
                <span class="auth-form__error" asp-validation-for="Password"></span>

                <label class="auth-form__label" asp-for="ConfirmPassword">Confirm Password</label>
                <input class="auth-form__input" asp-for="ConfirmPassword" autocomplete="new-password" />
                <span class="auth-form__error" asp-validation-for="ConfirmPassword"></span>

                <button class="btn-primary auth-form__submit" type="submit">Create account</button>
            </form>

            <p class="auth-card__foot">
                Already have an account?
                <a asp-controller="Account" asp-action="Login">Sign in</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
