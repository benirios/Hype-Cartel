@model List<OrderManageItem>
@{
    ViewData["Title"] = "Admin · Orders";
}

<section class="catalog-hero">
    <div class="container">
        <h1 class="catalog-hero__title">ADMIN · ORDERS</h1>
    </div>
</section>

<section class="container" style="padding-bottom: var(--space-xl);">
    @if (TempData["OrderAdminError"] is string error && !string.IsNullOrWhiteSpace(error))
    {
        <div class="auth-form__error" style="margin-bottom:1rem;">@error</div>
    }

    <div class="admin-panel__section">
        <a class="btn-ghost" asp-controller="Reports" asp-action="Index">← Back to Reports</a>

        <table style="width:100%; margin-top:1rem; border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="text-align:left; padding:0.5rem;">Order</th>
                    <th style="text-align:left; padding:0.5rem;">User</th>
                    <th style="text-align:left; padding:0.5rem;">Status</th>
                    <th style="text-align:right; padding:0.5rem;">Total</th>
                    <th style="text-align:left; padding:0.5rem;">Created</th>
                    <th style="text-align:left; padding:0.5rem;">Action</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">#@order.OrderId</td>
                    <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">@order.UserId</td>
                    <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">@order.Status</td>
                    <td style="padding:0.5rem; border-top:1px solid #2d2d2d; text-align:right;">$@order.Total.ToString("0.00")</td>
                    <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">@order.CreatedAtUtc.ToString("u")</td>
                    <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">
                        <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                            <a class="btn-outline" asp-controller="OrdersAdmin" asp-action="Detalhes" asp-route-id="@order.OrderId">Details</a>
                            <form method="post" asp-controller="OrdersAdmin" asp-action="UpdateStatus" style="display:flex; gap:0.5rem;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                <select class="auth-form__input" name="newStatus" style="min-width:140px;">
                                    @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                                    {
                                        if (order.Status == status)
                                        {
                                            <option value="@status" selected>@status</option>
                                        }
                                        else
                                        {
                                            <option value="@status">@status</option>
                                        }
                                    }
                                </select>
                                <button class="btn-ghost" type="submit">Update</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
