@model List<OrderHistoryItem>
@{
    ViewData["Title"] = "Order Status History";
}

<section class="catalog-hero">
    <div class="container">
        <h1 class="catalog-hero__title">ORDER STATUS HISTORY</h1>
    </div>
</section>

<section class="container" style="padding-bottom: var(--space-xl);">
    <div class="admin-panel__section">
        <a class="btn-ghost" asp-controller="Reports" asp-action="Index">← Back to Reports</a>
        <table style="width:100%; margin-top:1rem; border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="text-align:left; padding:0.5rem;">Order</th>
                    <th style="text-align:left; padding:0.5rem;">From</th>
                    <th style="text-align:left; padding:0.5rem;">To</th>
                    <th style="text-align:left; padding:0.5rem;">Changed At</th>
                    <th style="text-align:left; padding:0.5rem;">Changed By</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">#@item.OrderId</td>
                    <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">@item.FromStatus</td>
                    <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">@item.ToStatus</td>
                    <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">@item.ChangedAtUtc.ToString("u")</td>
                    <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">@item.ChangedBy</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
