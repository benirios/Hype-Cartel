@model List<UserOrderViewModel>
@{
    ViewData["Title"] = "My Orders";
}

<section class="catalog-hero">
    <div class="container">
        <h1 class="catalog-hero__title">MY ORDERS</h1>
    </div>
</section>

<section class="container" style="padding-bottom: var(--space-xl);">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h2 class="empty-state__title">You have no orders yet.</h2>
            <p class="empty-state__text">After checkout, your order history will appear here.</p>
            <a class="btn-outline" asp-controller="Produtos" asp-action="Index">Start shopping</a>
        </div>
    }
    else
    {
        <div class="admin-panel__section">
            <table style="width:100%; border-collapse:collapse;">
                <thead>
                    <tr>
                        <th style="text-align:left; padding:0.5rem;">Order</th>
                        <th style="text-align:left; padding:0.5rem;">Date</th>
                        <th style="text-align:left; padding:0.5rem;">Status</th>
                        <th style="text-align:right; padding:0.5rem;">Total</th>
                        <th style="text-align:left; padding:0.5rem;">Details</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">#@order.Id</td>
                        <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">@order.CreatedAtUtc.ToString("u")</td>
                        <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">@order.Status</td>
                        <td style="padding:0.5rem; border-top:1px solid #2d2d2d; text-align:right;">$@order.Total.ToString("0.00")</td>
                        <td style="padding:0.5rem; border-top:1px solid #2d2d2d;">
                            <a class="btn-ghost" asp-controller="Encomendas" asp-action="Detalhes" asp-route-id="@order.Id">View</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
